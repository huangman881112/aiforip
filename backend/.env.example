# AI 助教上游配置（本地开发用：cp .env.example .env 后填真实密钥）
# scripts/dev-backend.sh 会 source 本文件；${VAR:-默认} 写法允许命令行临时覆盖
# 局域网 API 中转站（FastAPI「API 中转站」，按模型名前缀路由上游）
AI_BASE_URL=${AI_BASE_URL:-http://192.168.1.8:8000/v1}
AI_API_KEY=sk-replace-me
# 主模型 / 备用模型（逗号分隔，依次降级）。可用模型见中转站 /admin/api/opencode/models
# 备用模型可用 name@maxTokens@timeoutSeconds 单独设预算（本地思考模型需 2000+）
AI_MODEL=${AI_MODEL:-deepseek-chat}
AI_FALLBACK_MODELS=${AI_FALLBACK_MODELS:-qwen3.5:9b@6000@150@low}
AI_TIMEOUT_SECONDS=${AI_TIMEOUT_SECONDS:-90}
AI_MAX_TOKENS=${AI_MAX_TOKENS:-1200}
AI_TEMPERATURE=${AI_TEMPERATURE:-0.4}
AI_KNOWLEDGE=${AI_KNOWLEDGE:-true}
AI_RATE_PER_MINUTE=${AI_RATE_PER_MINUTE:-12}
# 允许在「AI 助教」页面修改中转站配置（地址/token/模型/测试连接）的用户名，逗号分隔
# 白名单用户还是唯一能看到「全量模型与真实模型名」的人：普通用户在 /api/ai/status 与顶栏徽章上只看得到中转站（供应商），
# 因为后端已对普通用户做了脱敏（模型名/预算/备注一律不下发）；而能使用的模型仍只限被标为开放（userVisible=true，默认开放）的那些，
# 而且选「自动」时也只会在这些模型里降级；GET /api/ai/upstream-models 也仅白名单内可调用
# 未登录更是连清单都拿不到（/api/ai/status、/api/ai/models 返回 loginRequired=true + 空数组）
AI_ADMIN_USERNAMES=${AI_ADMIN_USERNAMES:-admin}

# ---------- 多中转站 / 多模型（可选） ----------
# 不必改本文件：页面上「AI 助教 → ⚙️ 中转站配置」就能加/改第三方中转站（地址 + token + 模型），
# 保存写入 SQLite 表 app_settings（key=ai.providers）并热生效；页面配置优先级高于本文件，
# 两者的模型会合并；在页面上加一条同名但 enabled=false 的模型可屏蔽本文件里的坏兜底模型。
# 只接一个中转站时留空即可（上面的 AI_MODEL / AI_FALLBACK_MODELS 已够）。
# 需要「A 站主用 + B 站兜底 + 本机 llama.cpp 最后兜底」时，用 JSON 数组声明：
#   字段同 application.yml 的 suanfa.ai.providers，但写成 camelCase（maxTokens 而不是 max-tokens）。
#   provider: id / label / baseUrl / apiKey / enabled / requireKey / headers / maxTokens / timeoutSeconds / temperature / models[]
#   model:    name / label / enabled / userVisible / primary / maxTokens / timeoutSeconds / temperature / reasoningEffort / note
#             userVisible=false 表示「仅管理员可选」（普通用户看不到，也不参与他们的自动降级），省略即 true
# 配好后用管理员登录态调 GET /api/ai/upstream-models 校对中转站真实的模型名（中转站路由名常与厂商名不同）。
# 示例（单行即可，这里换行仅为可读）：
# AI_PROVIDERS_JSON='[
#   {"id":"relay-a","label":"中转站 A","baseUrl":"http://192.168.1.8:8000/v1","apiKey":"sk-xxx",
#    "models":[{"name":"deepseek-chat","label":"DeepSeek Chat","primary":true,"maxTokens":1200},
#              {"name":"kimi-k2","label":"Kimi K2（月度限额）","maxTokens":1500}]},
#   {"id":"local","label":"本机 llama.cpp","baseUrl":"http://127.0.0.1:8080/v1","requireKey":false,
#    "models":[{"name":"qwen3.5:9b","label":"Qwen3.5 9B（本地兜底）","maxTokens":6000,"timeoutSeconds":150,"reasoningEffort":"low"}]}]'
AI_PROVIDERS_JSON=${AI_PROVIDERS_JSON:-}

# ---------- 邮箱验证码（修改密码）----------
# 管理员在「用户名 → 修改密码」里需要邮箱验证码，验证码由后端 SMTP 发出。
# MAIL_HOST 留空 = 不接 SMTP 的「开发模式」：验证码只写后端日志，并随接口响应回传前端（方便本地跑通流程）。
# QQ / 163 等邮箱的 MAIL_PASSWORD 要填「SMTP 授权码」，不是登录密码。
#   QQ 邮箱：host=smtp.qq.com port=465 ssl=true（先在网页端开启 SMTP 并取授权码）
#   163 邮箱：host=smtp.163.com port=465 ssl=true（下方默认值，授权码自填）
#   Gmail ：host=smtp.gmail.com port=587 ssl=false（走 STARTTLS，需应用专用密码）
MAIL_HOST=${MAIL_HOST:-smtp.163.com}
MAIL_PORT=${MAIL_PORT:-465}
MAIL_USERNAME=${MAIL_USERNAME:-yitian_hm@163.com}
# 必填 SMTP 授权码（不是邮箱登录密码）：163 网页端 → 设置 → POP3/SMTP → 开启后领取
MAIL_PASSWORD=${MAIL_PASSWORD:-REPLACE_WITH_SMTP_AUTH_CODE}
# 发件人，留空则用 MAIL_USERNAME；必须填完整邮箱地址，写用户名（如 xbxsf）会被 SMTP 拒收
MAIL_FROM=${MAIL_FROM:-}
MAIL_SSL=${MAIL_SSL:-true}
# 验证码有效期 / 重发间隔 / 最多校验尝试次数
MAIL_CODE_TTL=${MAIL_CODE_TTL:-600}
MAIL_RESEND_COOLDOWN=${MAIL_RESEND_COOLDOWN:-60}
MAIL_MAX_ATTEMPTS=${MAIL_MAX_ATTEMPTS:-5}
# 只在「未配 SMTP」（MAIL_HOST 留空）时起作用：开发模式下验证码随响应回传前端跑通流程。
# 一旦 MAIL_HOST 非空，本开关失效，真实发信不会外泄验证码；生产环境显式置 false 更稳。
MAIL_DEV_ECHO_CODE=${MAIL_DEV_ECHO_CODE:-true}

# 本地工具链：Go（代码工作台 go 语言需要；其他 gcc/g++/python3/javac/node 在系统 PATH 中）
# 示例：go 装在哪就把 bin 目录加进 PATH（dev-backend.sh 会 source 本文件）
export PATH="$HOME/go-toolchain/go/bin:$PATH"  # 按实际安装路径修改
